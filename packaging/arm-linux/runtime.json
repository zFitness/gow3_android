{
  "schema": "fexdroid.runtime.v1",
  "id": "spartanport",
  "name": "SpartanPort",
  "upstream": "https://github.com/FelipePrado0/SpartanPort",
  "version": "2.7.0",
  "arch": "arm64",
  "program": "gport",
  "description": "God of War III Remastered 的 PC 移植启动器平台：内含补丁、作弊码、图形选项与游戏内悬浮菜单；fexdroid 提供画面（X11）、音频（PulseAudio）与 Vulkan 驱动（Turnip）。",
  "entry": { "run": "entry.sh" },
  "entries": [
    { "id": "game", "name": "一键进游戏", "kind": "direct",
      "command": "entry.sh game",
      "desc": "按当前配置直接运行（补丁按版本差异自动匹配）" },
    { "id": "launcher", "name": "SpartanPort 启动器", "kind": "launcher",
      "command": "entry.sh launcher",
      "desc": "完整启动器（Tkinter）：补丁、作弊码、图形、帧率全在这里配置；需要 rootfs 的 tkinter" },
    { "id": "check", "name": "导入自检", "kind": "direct", "advanced": true,
      "command": "entry.sh check",
      "desc": "对已准备的镜像做导入完整性检查（先运行一次游戏）" },
    { "id": "vulkan", "name": "Vulkan 自检", "kind": "direct", "advanced": true,
      "command": "entry.sh vulkan",
      "desc": "不进游戏，只验证驱动与显示桥" }
  ],
  "capabilities": {
    "config": {
      "schema": "entry.sh config schema",
      "get": "entry.sh config get",
      "set": "entry.sh config set"
    },
    "info": { "patches": "entry.sh info patches" }
  },
  "requires": { "python": "3.13" },
  "storage": { "data": "gdata", "home": "home/gport" },
  "env": {
    "SPARTAN_GAME_DIR": "/storage/emulated/0/games/ps4/GOW3 ROM/CUSA01740"
  },
  "assets": { "cover": "assets/cover.png" }
}
