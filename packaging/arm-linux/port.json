{
  "schema": "nixport.port.v1",
  "id": "spartanport",
  "name": "SpartanPort",
  "version": "2.7.0",
  "arch": "arm64",
  "appimage": "SpartanPort-arm64.AppImage",
  "program": "squashfs-root",
  "description": "God of War III Remastered：FEX guest CPU + shadPS4 图形栈的 ARM64 移植；补丁、作弊码、图形、游戏目录全部在启动器内配置",
  "upstream": "https://github.com/FelipePrado0/SpartanPort",
  "entries": [
    {
      "id": "launcher",
      "name": "SpartanPort 启动器",
      "kind": "launcher",
      "command": "AppRun launcher",
      "desc": "补丁、作弊码、图形、游戏目录全在这里配置"
    },
    {
      "id": "game",
      "name": "一键进游戏",
      "kind": "direct",
      "command": "AppRun game",
      "display": "x11",
      "desc": "按当前配置直接运行（会话显示）"
    },
    {
      "id": "game-direct",
      "name": "一键进游戏（直通帧）",
      "kind": "direct",
      "command": "AppRun game-direct",
      "display": "direct",
      "desc": "跳过会话合成，直通帧显示（延迟更低）"
    },
    {
      "id": "check",
      "name": "导入自检",
      "kind": "direct",
      "advanced": true,
      "command": "AppRun check",
      "display": "x11",
      "desc": "链接产物与导入完整性检查"
    },
    {
      "id": "vulkan",
      "name": "Vulkan 自检",
      "kind": "direct",
      "advanced": true,
      "command": "AppRun vulkan",
      "display": "x11",
      "desc": "GPU 驱动与 Vulkan 环境检查"
    }
  ],
  "storage": {
    "home": "home"
  },
  "logs": [
    "home/gport/logs/launch.log"
  ],
  "assets": {
    "cover": "assets/cover.png"
  }
}